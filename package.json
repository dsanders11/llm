{
  "name": "@dsanders11/electron-llm",
  "version": "0.0.0-development",
  "description": "A LanguageModel subclass for the Electron Prompt API powered by node-llama-cpp.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "workspaces": [
    "end-to-end"
  ],
  "files": [
    "dist",
    "gen",
    "native",
    "binding.gyp",
    "README.md"
  ],
  "publishConfig": {
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./prompt-api": {
      "types": "./dist/prompt-api.d.ts",
      "default": "./dist/prompt-api.js"
    },
    "./prompt-api/windows": {
      "types": "./dist/prompt-api-windows.d.ts",
      "default": "./dist/prompt-api-windows.js"
    },
    "./prompt-api/macos": {
      "types": "./dist/prompt-api-macos.d.ts",
      "default": "./dist/prompt-api-macos.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tsc": "tsc --build",
    "lint:check": "prettier --check \"**/*.{ts,js}\"",
    "lint:fix": "prettier --write \"**/*.{ts,js}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run tsc",
    "install": "node-gyp rebuild || exit 0",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write"
    ]
  },
  "author": "Electron Community",
  "keywords": [
    "electron",
    "llm",
    "ai",
    "prompt-api",
    "llama",
    "llama.cpp",
    "node-llama-cpp",
    "gguf"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsanders11/llm.git"
  },
  "dependencies": {
    "dynwinrt-js": "^0.1.6",
    "node-addon-api": "^8.3.0",
    "node-llama-cpp": "^3.7.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "electron": "^39.8.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18",
    "winrt-meta": "^0.1.6"
  },
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f",
  "dependenciesMeta": {
    "electron": {
      "built": true
    }
  }
}
